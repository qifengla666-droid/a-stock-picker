# Tushare API Token (https://tushare.pro)
TUSHARE_TOKEN=your_token_here

# 数据库配置
DATABASE_URL=sqlite:///data/stocks.db

# API 服务配置
API_HOST=0.0.0.0
API_PORT=8000

# 前端配置
REACT_APP_API_URL=http://localhost:8000

# 日志级别
LOG_LEVEL=INFO

# 数据更新间隔（分钟）
UPDATE_INTERVAL=60

# 扫描时间（HH:MM，24小时制）
SCAN_TIME=09:30